# App
PORT=3001
CORS_ORIGIN=http://localhost:4200

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Authentication
# JWT_SECRET is required at app startup. BOOTCAMP_INITIAL_PASSWORD is required
# only when seeding credentials. Never reuse these examples in deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_TTL_SECONDS=3600
BOOTCAMP_INITIAL_PASSWORD=replace-with-an-operator-supplied-password

# TimeTracker external API (docs/api-external-openapi.json) — Epic 13 leave/project
# sync only; the bootcamp seed uses a bundled JSON manifest (see Seed data below).
# Leave commented out unless you are working on TimeTracker integration.
TIMETRACKER_BASE_URL=https://tt-bootcamp.dev.altexsoft.dev/
# TIMETRACKER_ACCOUNTING_API_KEY=
# TIMETRACKER_TALENTS_API_KEY=
# Optional outbound link shown on self-service S10 (Story 13.1)
# TIMETRACKER_MANAGE_LEAVE_URL=https://tt-bootcamp.dev.altexsoft.dev/leaves

# Story 1.3 — department-history value identifying HR for PP HR-line access resolution
HR_DEPARTMENT_VALUE=HR

# Story 1.13 — access-resolution cache (AD-4: disabled by default; enable for perf / Story 3.7)
# ACCESS_RESOLUTION_CACHE_ENABLED=true
# ACCESS_RESOLUTION_CACHE_TTL_MS=60000

# E2E tests — see test/README.md
# Keep the per-worker schemas after a run, to inspect what a failure left behind
# TEA_KEEP_TEST_SCHEMAS=1
# Rename the per-worker schemas (default: tea_test)
# TEA_TEST_SCHEMA_PREFIX=tea_test
# Allow provisioning against a non-local DATABASE_URL. The setup DROPs schemas,
# so this is off by default on purpose.
# TEA_ALLOW_REMOTE_TEST_DB=1
