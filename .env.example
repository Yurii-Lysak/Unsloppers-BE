# App
PORT=3001
CORS_ORIGIN=http://localhost:4200

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Authentication
# JWT_SECRET is required at app startup. BOOTCAMP_INITIAL_PASSWORD is required
# only when seeding credentials. Never reuse these examples in deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_TTL_SECONDS=3600
BOOTCAMP_INITIAL_PASSWORD=replace-with-an-operator-supplied-password

# TimeTracker external API (docs/api-external-openapi.json) — Epic 13 leave/project
# sync only; the bootcamp seed uses a bundled JSON manifest (see Seed data below).
# Leave commented out unless you are working on TimeTracker integration.
TIMETRACKER_BASE_URL=https://tt-bootcamp.dev.altexsoft.dev/
# TIMETRACKER_ACCOUNTING_API_KEY=
# TIMETRACKER_TALENTS_API_KEY=
