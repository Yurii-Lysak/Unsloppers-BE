# App
PORT=3001
CORS_ORIGIN=http://localhost:4200

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# TimeTracker external API (docs/api-external-openapi.json) — seed-time only,
# see prisma/seed.ts. Left commented out on purpose: Joi treats an empty
# string as invalid even when the key is optional, so a present-but-empty
# value here would break `npm run start:dev` after a plain `cp .env.example
# .env`. Uncomment and fill in both keys only when you need to run the seed.
TIMETRACKER_BASE_URL=https://tt-bootcamp.dev.altexsoft.dev/
# TIMETRACKER_ACCOUNTING_API_KEY=
# TIMETRACKER_TALENTS_API_KEY=
