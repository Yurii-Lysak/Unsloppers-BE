generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS runs on CommonJS — without this the generated client is ESM and breaks the build
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Story 1.16 — `hash`/`countryCode` are TimeTracker-sourced fields, stored
// verbatim from the Accounting endpoint (docs/api-external-openapi.json) and
// kept in sync with the latest fetch on every seed rerun. Nullable because
// the existing `users` CRUD module (src/modules/users) can create a `User`
// without going through the seed path at all — TimeTracker is the only
// identity source for these two fields, never a hand-authored value.
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  hash        String?
  passwordHash String?
  countryCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee?

  @@map("users")
}

// PRD §4.16 — employment status is the single source for whether someone has left.
// Story 1.11 uses this to reject dismissed employees as shared-link recipients.
enum EmploymentStatus {
  active
  dismissed
}

// Story 1.20 — minimal Wave-0 shape (1:1 with User); later stories (1.1, 1.6)
// add fields as they're needed. An Employee has no lifecycle independent of
// its User, hence Cascade.
model Employee {
  id        String   @id @default(uuid())
  userId    String   @unique
  employmentStatus EmploymentStatus @default(active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  gradeHistory          GradeHistory[]
  positionHistory       PositionHistory[]
  departmentHistory     DepartmentHistory[]
  employmentTypeHistory EmploymentTypeHistory[]
  timelineEvents        TimelineEvent[]
  customFieldValues     CustomFieldValue[]

  // Story 1.1 — reports-to edge that C1 AccessResolver's ReportingLine closure
  // walks. `onDelete: SetNull` orphans direct reports to top-of-chain when a
  // manager's Employee row is deleted, rather than re-linking them to the
  // grand-manager (see spec-1-1 Design Notes) — no automatic reassignment.
  managerId     String?
  manager       Employee?  @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[] @relation("ReportsTo")

  // Story 1.3 — assigned People Partner for PP access resolution (C1). Singular
  // FK: at most one active PP per employee. `onDelete: SetNull` clears the
  // assignment when the PP's Employee row is deleted rather than blocking delete.
  peoplePartnerId String?
  peoplePartner     Employee?  @relation("PeoplePartnerAssignment", fields: [peoplePartnerId], references: [id], onDelete: SetNull)
  ppAssignments     Employee[] @relation("PeoplePartnerAssignment")

  // Story 1.2 — the three legs of a ProjectAssignment row that can name this
  // Employee: the assigned employee, and the project's PM/DM. Three distinct
  // relation names disambiguate the 3 FKs Prisma would otherwise see as
  // ambiguous references to the same model (mirrors "ReportsTo" above).
  projectAssignments   ProjectAssignment[] @relation("ProjectAssignmentEmployee")
  pmProjectAssignments ProjectAssignment[] @relation("ProjectAssignmentPm")
  dmProjectAssignments ProjectAssignment[] @relation("ProjectAssignmentDm")

  externalIdentities ExternalIdentity[]
  functionalRoleAssignments FunctionalRoleAssignment[]

  managementNotesAbout   ManagementNote[] @relation("ManagementNoteSubject")
  managementNotesAuthored ManagementNote[] @relation("ManagementNoteAuthor")

  riskRecordsAbout    RiskRecord[] @relation("RiskRecordSubject")
  riskRecordsAuthored RiskRecord[] @relation("RiskRecordAuthor")

  actionItemsAssigned ActionItem[] @relation("ActionItemAssignee")
  actionItemsAuthored ActionItem[] @relation("ActionItemAuthor")

  // Story 10.1 — campaigns this employee created (creator-scoped list/get/patch).
  createdCampaigns FormCampaign[] @relation("FormCampaignCreator")

  // Story 1.7 — active mentorship pairs where this employee is mentor or mentee.
  mentorPairs MentorshipPair[] @relation("MentorPairs")
  menteePairs MentorshipPair[] @relation("MenteePairs")

  sharedLinksCreated   SharedLink[] @relation("SharedLinkCreator")
  sharedLinksReceived  SharedLink[] @relation("SharedLinkRecipient")
  sharedLinksAsSubject SharedLink[] @relation("SharedLinkSubject")

  journalEntriesAsActor   RelationshipJournalEntry[] @relation("JournalActor")
  journalEntriesAsSubject RelationshipJournalEntry[] @relation("JournalSubject")

  fullAccessGrants FullAccessGrant[]

  @@index([managerId])
  @@index([peoplePartnerId])
  @@map("employees")
}

// Story 1.2 — C3 ProjectAssignment's real persistence (contracts.md's
// ratified shape). Backs AccessResolverService's `ProjectLine` role: a
// confirmed, fresh, still-active row grants the PM/DM (and everyone above
// them via the reports-to walk) Manager-equivalent access to `employeeId`.
// `onDelete: Restrict` on all three Employee FKs: assignment rows must never
// be silently cascade-deleted when an Employee row is removed.
enum ProjectAssignmentSource {
  manual
  timetracker
}

model ProjectAssignment {
  id          String    @id @default(uuid())
  employeeId  String
  projectId   String
  pmId        String
  dmId        String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  source      ProjectAssignmentSource @default(manual)
  sourceKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation("ProjectAssignmentEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  pm       Employee @relation("ProjectAssignmentPm", fields: [pmId], references: [id], onDelete: Restrict)
  dm       Employee @relation("ProjectAssignmentDm", fields: [dmId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([projectId])
  @@index([source])
  @@map("project_assignments")
}

// Story 3.2 — runtime custom field definitions (AD-6). Options are stored as a
// JSON string array for select / multi_select types only.
enum CustomFieldType {
  text
  number
  date
  boolean
  select
  multi_select
}

enum CustomFieldVisibility {
  management
  employee
  colleague
}

model CustomFieldDefinition {
  id         String                @id @default(uuid())
  name       String                @unique
  type       CustomFieldType
  visibility CustomFieldVisibility @default(management)
  options    Json?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  values CustomFieldValue[]

  @@map("custom_field_definitions")
}

// Story 3.2 — typed value storage (AD-6). Exactly one value column is populated
// per row; the rest are NULL. Rows exist only after the first write (lazy).
// multi_select values are JSON-encoded string arrays in valueText.
model CustomFieldValue {
  id                String   @id @default(uuid())
  employeeId        String
  fieldDefinitionId String
  valueText         String?
  valueNumber       Decimal? @db.Decimal(18, 6)
  valueDate         DateTime? @db.Date
  valueBoolean      Boolean?
  valueSelect       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([employeeId, fieldDefinitionId])
  @@index([fieldDefinitionId])
  @@index([employeeId])
  @@map("custom_field_values")
}

// Four effective-dated history tables (AD-7). `effectiveTo IS NULL` = current
// row. The only legal write path is the Prisma Client Extension in
// `src/prisma/extensions/temporal-history.extension.ts` — no service may
// write here directly (enforced by the extension, not by the schema).
//
// `@@unique([employeeId])` below is a PLACEHOLDER: Prisma's schema DSL
// cannot express a partial/filtered unique index. The migration step
// hand-edits the generated SQL to narrow this into
// `UNIQUE ("employeeId") WHERE "effectiveTo" IS NULL` — the real DB-level
// backstop for "at most one open row per employee". Do not remove this
// annotation; it is what causes Prisma to emit the index to narrow.
//
// `value` is untyped `String` on purpose — Wave-0 does not validate against
// a per-dimension domain/enum (that's a later story's concern).
//
// `onDelete: Restrict` on `employeeId`: history rows must never be silently
// cascade-deleted when an Employee row is removed.
//
// `@@index([employeeId])` (iteration 2 patch): a plain, non-partial index
// alongside the placeholder unique one above — ordinary `findMany({ where:
// { employeeId } })` reads (used by the extension itself and throughout the
// test suite) can't use the partial unique index, and would sequential-scan
// as tables grow without this.
model GradeHistory {
  id            String    @id @default(uuid())
  employeeId    String
  value         String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId])
  @@index([employeeId])
  @@map("grade_history")
}

model PositionHistory {
  id            String    @id @default(uuid())
  employeeId    String
  value         String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId])
  @@index([employeeId])
  @@map("position_history")
}

model DepartmentHistory {
  id            String    @id @default(uuid())
  employeeId    String
  value         String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId])
  @@index([employeeId])
  @@map("department_history")
}

model EmploymentTypeHistory {
  id            String    @id @default(uuid())
  employeeId    String
  value         String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId])
  @@index([employeeId])
  @@map("employment_type_history")
}

// Story 7.1/7.2 — C4 persists system/manual rows; soft-delete + partial unique
// index (active rows only) live in migration SQL — see
// `timeline_events_active_key` WHERE deleted_at IS NULL.
model TimelineEvent {
  id            String    @id @default(uuid())
  employeeId    String
  type          String
  effectiveDate DateTime  @db.Date
  oldValue      Json?
  newValue      Json?
  source                String
  authorId              String?
  systemWriteSkippedAt  DateTime?
  deletedAt             DateTime?
  deletedById           String?
  updatedAt             DateTime  @updatedAt
  updatedById           String?
  createdAt             DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, type, effectiveDate, source])
  @@map("timeline_events")
}

// Story 13.1 / C5 — cross-system identity mapping (Wave-1 shape; Story 13.4 may refine).
enum ExternalIdentitySystem {
  peopleforce
  timetracker
}

model ExternalIdentity {
  id           String                 @id @default(uuid())
  system       ExternalIdentitySystem
  externalId   String
  employeeId   String
  supersededBy String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([system, externalId])
  @@index([employeeId])
  @@map("external_identities")
}

// Story 1.4 — functional roles and feature permissions (C8). Permission keys are
// strings validated against contracts/permission-keys.ts, not a Prisma enum.
model FunctionalRole {
  id        String   @id @default(uuid())
  /// Case-insensitive uniqueness enforced by functional_roles_name_lower_key (see migration).
  name      String
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions FunctionalRolePermission[]
  assignments FunctionalRoleAssignment[]

  @@map("functional_roles")
}

model FunctionalRolePermission {
  id            String @id @default(uuid())
  roleId        String
  permissionKey String

  role FunctionalRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([roleId])
  @@map("functional_role_permissions")
}

model FunctionalRoleAssignment {
  id         String   @id @default(uuid())
  employeeId String
  roleId     String
  createdAt  DateTime @default(now())

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role     FunctionalRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, roleId])
  @@index([employeeId])
  @@index([roleId])
  @@map("functional_role_assignments")
}

// Story 1.9 — S7 management notes with dual visibility flags (access-model Rule 3).
// `onDelete: Restrict` — notes are not cascade-deleted when an employee row is
// removed; explicit cleanup belongs to the future employment departure cascade.
model ManagementNote {
  id                 String   @id @default(uuid())
  subjectEmployeeId  String
  authorEmployeeId   String
  content            String   @db.Text
  visibleForEmployee Boolean  @default(false)
  visibleForPm       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subjectEmployee Employee @relation("ManagementNoteSubject", fields: [subjectEmployeeId], references: [id], onDelete: Restrict)
  authorEmployee  Employee @relation("ManagementNoteAuthor", fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  @@index([subjectEmployeeId])
  @@map("management_notes")
}

enum RiskLevel {
  low
  need_attention
  medium
  high
  leaver
}

model RiskRecord {
  id                String    @id @default(uuid())
  subjectEmployeeId String
  authorEmployeeId  String
  level             RiskLevel
  description       String    @db.VarChar(500)
  details           String    @db.Text
  recordedAt        DateTime  @db.Date
  createdAt         DateTime  @default(now())

  subjectEmployee Employee @relation("RiskRecordSubject", fields: [subjectEmployeeId], references: [id], onDelete: Restrict)
  authorEmployee  Employee @relation("RiskRecordAuthor", fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  @@index([subjectEmployeeId])
  @@map("risk_records")
}

enum ActionItemStatus {
  open
  completed
  cancelled
}

enum ActionItemSource {
  manual
  campaign
}

// Story 4.1 — S14 action items (CAP-4). `campaignId` gets its FK to
// `FormCampaign` in Story 10.1 (schema.prisma's own comment pointed here).
model ActionItem {
  id              String           @id @default(uuid())
  assigneeId      String
  authorId        String
  title           String
  description     String?          @db.Text
  dueDate         DateTime         @db.Date
  link            String?
  status          ActionItemStatus @default(open)
  source          ActionItemSource
  campaignId      String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignee Employee      @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  author   Employee      @relation("ActionItemAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  campaign FormCampaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([campaignId, assigneeId])
  @@index([assigneeId])
  @@index([authorId])
  @@map("action_items")
}

// Story 10.1 — draft-only Form Campaign record (CAP-10, epic-10-context.md).
// `active` is included now so Story 10.3's activation transition doesn't need
// a second migration; only `draft` is reachable until then.
enum FormCampaignStatus {
  draft
  active
}

model FormCampaign {
  id          String             @id @default(uuid())
  creatorId   String
  title       String
  description String             @db.VarChar(500)
  purpose     String             @db.Text
  link        String
  dueDate     DateTime           @db.Date
  status                    FormCampaignStatus @default(draft)
  audienceFilters           Json               @default("[]")
  audienceAddedEmployeeIds  String[]           @default([])
  audienceExcludedEmployeeIds String[]         @default([])
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  creator     Employee     @relation("FormCampaignCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  actionItems ActionItem[]

  @@index([creatorId])
  @@map("form_campaigns")
}

// Story 1.7 — minimal read substrate for profile-header mentor resolution.
// Epic 9 adds closure note, consent checks, and write APIs. Partial unique on
// active mentee is enforced in migration SQL — see Design Notes in spec 1.7.
model MentorshipPair {
  id        String    @id @default(uuid())
  mentorId  String
  menteeId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  mentor Employee @relation("MentorPairs", fields: [mentorId], references: [id], onDelete: Restrict)
  mentee Employee @relation("MenteePairs", fields: [menteeId], references: [id], onDelete: Restrict)

  @@index([menteeId, endedAt])
  @@index([mentorId])
  @@map("mentorship_pairs")
}

// Story 1.11 — shareable profile links (section-scoped, named recipient).
// Expiry enforcement, access logging, and revocation are Story 1.12.
model SharedLink {
  id                  String    @id @default(uuid())
  token               String    @unique
  subjectEmployeeId   String
  creatorEmployeeId   String
  recipientEmployeeId String
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  subjectEmployee   Employee @relation("SharedLinkSubject", fields: [subjectEmployeeId], references: [id], onDelete: Restrict)
  creatorEmployee   Employee @relation("SharedLinkCreator", fields: [creatorEmployeeId], references: [id], onDelete: Restrict)
  recipientEmployee Employee @relation("SharedLinkRecipient", fields: [recipientEmployeeId], references: [id], onDelete: Restrict)
  sections          SharedLinkSection[]

  @@index([subjectEmployeeId])
  @@index([recipientEmployeeId])
  @@map("shared_links")
}

model SharedLinkSection {
  id           String @id @default(uuid())
  sharedLinkId String
  sectionId    String

  sharedLink SharedLink @relation(fields: [sharedLinkId], references: [id], onDelete: Cascade)

  @@unique([sharedLinkId, sectionId])
  @@map("shared_link_sections")
}

// Story 1.12 — C10 RelationshipJournal (shared_link_access only in this story).
model RelationshipJournalEntry {
  id                String   @id @default(uuid())
  actorEmployeeId   String?
  subjectEmployeeId String
  kind              String
  before            Json?
  after             Json
  createdAt         DateTime @default(now())

  actorEmployee   Employee? @relation("JournalActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  subjectEmployee Employee  @relation("JournalSubject", fields: [subjectEmployeeId], references: [id], onDelete: Restrict)

  @@index([subjectEmployeeId, kind, createdAt])
  @@map("relationship_journal_entries")
}

// Story 1.13 — monotonic generation counter for D1/AD-4 access-resolution cache
// invalidation. Single row; bumped synchronously on relationship-graph writes.
model AccessGraphGeneration {
  id         String @id @default("default")
  generation BigInt @default(0)

  @@map("access_graph_generation")
}

// Story 1.12 — dedicated full-profile access grant (access-model.md § Full profile access).
// Active holder ⇔ revokedAt IS NULL. Grant/revoke UI and journal kinds are out of scope.
model FullAccessGrant {
  id         String    @id @default(uuid())
  employeeId String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, revokedAt])
  @@map("full_access_grants")
}
